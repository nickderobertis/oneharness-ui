{
  "name": "conversation-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/conversation-ui/src",
  "tags": ["scope:ui", "type:app"],
  "implicitDependencies": ["ipc-contract", "oneharness-bridge"],
  "targets": {
    "build": {
      "command": "bun run --cwd apps/conversation-ui build",
      "outputs": ["{projectRoot}/out"]
    },
    "test": {
      "command": "bun test --preload ./packages/ui/test/setup.ts --coverage --coverage-dir coverage/conversation-ui apps/conversation-ui/src apps/conversation-ui/test",
      "outputs": ["{workspaceRoot}/coverage/conversation-ui"],
      "inputs": [
        "default",
        "^production",
        "testRunners",
        "{workspaceRoot}/packages/ui/test/setup.ts"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx biome check --error-on-warnings apps/conversation-ui",
          "node scripts/check-boundaries.mjs"
        ],
        "parallel": false
      }
    },
    "format": {
      "command": "bunx biome format --write apps/conversation-ui"
    },
    "typecheck": {
      "command": "bunx tsc -p apps/conversation-ui/tsconfig.json --noEmit"
    },
    "format-check": {
      "command": "bunx biome format apps/conversation-ui"
    }
  }
}
