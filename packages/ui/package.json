{
  "name": "@oneharness/ui",
  "version": "0.1.0",
  "description": "Presentational React components for oneharness conversations",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && bun run build:css",
    "build:css": "bun ./scripts/build-css.ts",
    "test": "bun test --preload ../../apps/conversation-ui/test/setup.ts test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@radix-ui/react-accordion": ">=1.2.0 <2",
    "@radix-ui/react-avatar": ">=1.2.0 <2",
    "@radix-ui/react-collapsible": ">=1.1.0 <2",
    "@radix-ui/react-dialog": ">=1.1.0 <2",
    "@radix-ui/react-label": ">=2.1.0 <3",
    "@radix-ui/react-popover": ">=1.1.0 <2",
    "@radix-ui/react-scroll-area": ">=1.2.0 <2",
    "@radix-ui/react-select": ">=2.2.0 <3",
    "@radix-ui/react-separator": ">=1.1.0 <2",
    "@radix-ui/react-slot": ">=1.2.0 <2",
    "@radix-ui/react-tabs": ">=1.1.0 <2",
    "@radix-ui/react-tooltip": ">=1.2.0 <2",
    "class-variance-authority": ">=0.7.0 <1",
    "clsx": ">=2.1.0 <3",
    "lucide-react": ">=0.468.0 <2",
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20",
    "react-markdown": ">=10.0.0 <11",
    "rehype-highlight": ">=7.0.0 <8",
    "tailwind-merge": ">=3.0.0 <4",
    "tailwindcss": ">=4.0.0 <5",
    "tw-animate-css": ">=1.3.0 <2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  }
}
