{
  "name": "github-workflows",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": ".github",
  "tags": ["scope:tooling", "type:tool"],
  "namedInputs": {
    "policy": ["{projectRoot}/**/*", "!{projectRoot}/node_modules/**/*", "!{projectRoot}/.telemetry/**/*", "{workspaceRoot}/scripts/verify-macos-artifact.sh", "{workspaceRoot}/scripts/release-assets.mjs", "{workspaceRoot}/scripts/set-version.mjs", "{workspaceRoot}/scripts/dispatch-release.sh", "{workspaceRoot}/scripts/checkout-release.sh", "{workspaceRoot}/scripts/upload-release.sh", "{workspaceRoot}/scripts/workflow-contract.test.ts", "{workspaceRoot}/justfile", "{workspaceRoot}/bun.lock", "{workspaceRoot}/package.json"]
  },
  "targets": {
    "test": {
      "cache": false,
      "inputs": ["policy"],
      "command": "just install-workspace && node --test .github/tests/*.test.mjs"
    },
    "budgets": {
      "cache": false,
      "dependsOn": ["test"],
      "inputs": ["policy"],
      "command": "node .github/check-budgets.mjs"
    },
    "lint": { "command": "just lint-workflows" },
    "typecheck": { "command": "node .github/check-syntax.mjs && bunx tsc -p .github/tsconfig.json" }
  }
}
